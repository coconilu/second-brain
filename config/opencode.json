{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["plugins/scan-reviewer.ts"],
  "agent": {
    "component-scanner": {
      "mode": "subagent",
      "description": "扫描项目构建可复用组件、hooks、工具函数和 API 客户端的目录。",
      "permission": {
        "edit": "deny",
        "bash": {
          "rg *": "allow",
          "find *": "allow",
          "ls *": "allow",
          "wc *": "allow",
          "git log *": "allow"
        }
      }
    },
    "post-generate-reviewer": {
      "mode": "subagent",
      "description": "对照项目可复用组件目录审查最近生成的代码，并重构以消除重复。",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "bash": {
          "git diff *": "allow",
          "git diff --cached *": "allow",
          "rg *": "allow",
          "git log *": "allow"
        }
      }
    }
  },
  "command": {
    "scan-index": {
      "template": "{file:./commands/scan-index.md}",
      "description": "扫描项目并生成可复用组件、hooks、工具函数和 API 客户端的目录。",
      "agent": "component-scanner",
      "subtask": true
    },
    "review-gen": {
      "template": "{file:./commands/review-gen.md}",
      "description": "对照可复用组件目录审查最近生成的代码并修复重复问题。",
      "agent": "post-generate-reviewer",
      "subtask": true
    }
  },
  "permission": {
    "skill": {
      "scan-reviewer": "allow"
    },
    "task": {
      "post-generate-reviewer": "allow"
    }
  }
}
